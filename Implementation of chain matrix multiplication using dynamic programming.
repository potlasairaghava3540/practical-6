
#include <iostream>
#include <climits>
using namespace std;

int matrixChain(int p[], int n)
{
    int dp[10][10];

    // Initialize diagonal elements
    for (int i = 1; i < n; i++)
    {
        dp[i][i] = 0;
    }

    // Chain length
    for (int len = 2; len < n; len++)
    {
        for (int i = 1; i < n - len + 1; i++)
        {
            int j = i + len - 1;
            dp[i][j] = INT_MAX;

            for (int k = i; k < j; k++)
            {
                int cost = dp[i][k] +
                           dp[k + 1][j] +
                           p[i - 1] * p[k] * p[j];

                if (cost < dp[i][j])
                {
                    dp[i][j] = cost;
                }
            }
        }
    }

    return dp[1][n - 1];
}

int main()
{
    int p[] = {10, 20, 30, 40};
    int n = sizeof(p) / sizeof(p[0]);

    cout << "Minimum number of multiplications = "
         << matrixChain(p, n);

    return 0;
}
